<?xml version="1.0" encoding="UTF-8"?>

<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xi="http://www.w3.org/2001/XInclude"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd"
    >

<!-- MODE: configure terminal -->
<VIEW name="configure-view">
    <!-- router bgp command -->
    <COMMAND name="router" help="Enable a routing process">
    </COMMAND>

    <COMMAND
        name="router bgp"
        help="Configure BGP routing protocol"
        view="configure-bgp-view"
        viewid="as=${bgp-as-number}"
        >
        <PARAM
            name="bgp-as-number"
            help="AS number"
            ptype="RANGE_1_4294967295"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp post_openconfig_bgp_bgp_global ${bgp-as-number} 0.0.0.0</ACTION>
    </COMMAND>

    <!-- no router bgp command -->
    <COMMAND name="no router" help="Disable a routing process">
    </COMMAND>

    <COMMAND
        name="no router bgp"
        help="Remove BGP routing protocol configuration"
        >
        <PARAM
            name="bgp-as-number"
            help="AS number"
            ptype="RANGE_1_4294967295"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp delete_openconfig_bgp_bgp_global</ACTION>
    </COMMAND>

    <!-- ip prefix-list command -->
    <COMMAND name="ip prefix-list" help="Configure IPv4 prefix-list">
        <PARAM 
            name="prefix-list-name"
            help="Name of the IPv4 prefix-list"
            ptype="STRING_63"
            >
            <PARAM
                name="seq"
                help="Sequence number"
                ptype="SUBCOMMAND"
                mode="subcommand"
                >
                <PARAM
                    name="seq-no"
                    help="Sequence number"
                    ptype="RANGE_1_65535"
                    >
                    <PARAM
                        name="action-switch"
                        help=""
                        ptype="SUBCOMMAND"
                        mode="switch"
                        >
                        <PARAM
                            name="permit"
                            help="Permit matching prefixes"
                            ptype="SUBCOMMAND"
                            mode="subcommand"
                            >
                            <PARAM
                                name="ip-prefix"
                                help="IP prefix (A.B.C.D/mask)"
                                ptype="IP_ADDR_MASK"
                                >
                                <PARAM
                                    name="le"
                                    help="Maximum prefix length to be matched"
                                    ptype="SUBCOMMAND"
                                    mode="subcommand"
                                    optional="true"
                                    >
                                    <PARAM  
                                        name="le-value"
                                        help="Maximum prefix length (0-32 for IPv4)"
                                        ptype="RANGE_0_32"
                                        >  
                                    </PARAM>
                                </PARAM>
                                <PARAM
                                    name="ge"
                                    help="Minimum prefix length to be matched"
                                    ptype="SUBCOMMAND"
                                    mode="subcommand"
                                    optional="true"
                                    >
                                    <PARAM
                                        name="ge-value"
                                        help="Minimum prefix length (0-32 for IPv4)"
                                        ptype="RANGE_0_32"
                                        >
                                    </PARAM>
                                </PARAM>
                            </PARAM>
                        </PARAM>
                        <PARAM  
                            name="deny"
                            help="Deny matching prefixes"
                            ptype="SUBCOMMAND"
                            mode="subcommand"
                            >
                            <PARAM
                                name="ip-prefix"
                                help="IP prefix (A.B.C.D/mask)"
                                ptype="IP_ADDR_MASK"
                                >
                                <PARAM
                                    name="le"
                                    help="Maximum prefix length to be matched"
                                    ptype="SUBCOMMAND"
                                    mode="subcommand"
                                    optional="true"
                                    >
                                    <PARAM
                                        name="le-value"
                                        help="Maximum prefix length (0-32 for IPv4)"
                                        ptype="RANGE_0_32"
                                        >
                                    </PARAM>
                                </PARAM>
                                <PARAM
                                    name="ge"
                                    help="Minimum prefix length to be matched"
                                    ptype="SUBCOMMAND"
                                    mode="subcommand"
                                    optional="true"
                                    >
                                    <PARAM
                                        name="ge-value"
                                        help="Minimum prefix length (0-32 for IPv4)"
                                        ptype="RANGE_0_32"
                                        >
                                    </PARAM>
                                </PARAM>
                            </PARAM>
                        </PARAM>
                    </PARAM>
                </PARAM>
            </PARAM>
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp put_openconfig_routing_policy_defined_sets_prefix_sets_prefix_set ${prefix-list-name} ${action-switch} ${ip-prefix} ${le-value} ${ge-value}</ACTION>
    </COMMAND>

    <!-- no ip prefix-list -->
    <COMMAND
        name="no ip prefix-list"
        help="Remove IPv4 prefix-list"
        >
        <PARAM
            name="prefix-list-name"
            help="Name of the IPv4 prefix-list"
            ptype="STRING_63"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp delete_openconfig_routing_policy_defined_sets_prefix_sets_prefix_set ${prefix-list-name}</ACTION>
    </COMMAND>

    <!-- route-map with permit/deny -->
    <COMMAND
        name="route-map"
        help="Configure route-map"
        view="config-route-map"
        viewid="name=${route-map-name};action=${action-switch};stmt_n=${stmt-n}"
        >
        <PARAM
            name="route-map-name"
            help="Name of the route-map"
            ptype="STRING_63"
            >
            <PARAM
                name="action-switch"
                help=""
                ptype="SUBCOMMAND"
                mode="switch"
                >
                <PARAM
                    name="permit"
                    help="Permit route"
                    ptype="SUBCOMMAND"
                    mode="subcommand"
                    >
                    <PARAM
                        name="stmt-n"
                        help="Statement number"
                        ptype="RANGE_1_65535"
                        >
                    </PARAM>
                </PARAM>
                <PARAM
                    name="deny"
                    help="Deny route"
                    ptype="SUBCOMMAND"
                    mode="subcommand"
                    >
                    <PARAM
                        name="stmt-n"
                        help="Statement number"
                        ptype="RANGE_1_65535"
                        >
                    </PARAM>
                </PARAM>
            </PARAM>
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp put_openconfig_routing_policy_policy_definitions_policy_definition_statements ${route-map-name} ${action-switch} ${stmt-n}</ACTION>
    </COMMAND>

    <COMMAND
        name="no route-map"
        help="Remove route-map"
        >
        <PARAM
            name="route-map-name"
            help="Name of the route-map"
            ptype="STRING_63"
            >
        </PARAM>
        <PARAM
            name="stmt-n"
            help="Statement number"
            ptype="RANGE_1_65535"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp delete_openconfig_routing_policy_policy_definitions_policy_definition_statements ${route-map-name} ${stmt-n}</ACTION>
    </COMMAND>

</VIEW>

<!-- MODE: config route map view -->
<VIEW name="config-route-map"
      prompt="${SYSTEM_NAME}(config-route-map)# "
      depth="2">
  
    <!-- Inheritance -->
    <NAMESPACE ref="configure-view"
               help="false"
               completion="false"/>

    <COMMAND name="no"
             help="Negate a command or set its defaults">
    </COMMAND>

    <!-- match ip address stubs -->
    <COMMAND name="match"
             help="Match values from routing table">
    </COMMAND>

    <COMMAND name="match ip"
             help="IP specific information">
    </COMMAND>

    <COMMAND name="match ip address"
             help="Match address of route">
    </COMMAND>

    <!-- match ip address prefix-list -->
    <COMMAND
        name="match ip address prefix-list"
        help="Match IP address using prefix-list"
        >
        <PARAM
            name="prefix-list-name"
            help="Name of the prefix-list"
            ptype="STRING_63"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp put_openconfig_routing_policy_policy_definitions_policy_definition_statements ${name} ${action} ${stmt_n} ${prefix-list-name}</ACTION>
    </COMMAND>

    <!-- no match ip address stubs -->
    <COMMAND name="no match"
             help="Delete match values from routing table">
    </COMMAND>

    <COMMAND name="no match ip"
             help="Delete IP specific information">
    </COMMAND>

    <COMMAND name="no match ip address"
             help="Delete match address of route">
    </COMMAND>

    <!-- no match ip address prefix-list -->
    <COMMAND
        name="no match ip address prefix-list"
        help="Remove match IP address prefix-list"
        >
        <ACTION builtin="clish_pyobj">sonic-cli-bgp delete_openconfig_routing_policy_policy_definitions_policy_definition_match_prefix_list ${name} ${action} ${stmt_n}</ACTION>
    </COMMAND>

</VIEW>

<!-- MODE: router bgp view -->
<VIEW
    name="configure-bgp-view"
    prompt="${SYSTEM_NAME}(config-router-bgp)# "
    depth="2"
    >
    <!-- Inheritance from configure-view -->
    <NAMESPACE
        ref="configure-view"
        help="false"
        completion="false"
        />

    <!-- show configuration -->
    <COMMAND name="show" help="Show configuration">
    </COMMAND>
    <COMMAND
        name="show bgp-global-config"
        help="Show BGP Global configuration"
        >
        <ACTION builtin="clish_pyobj">sonic-cli-bgp show_openconfig_bgp_bgp_global_config bgp_global_show.j2</ACTION>
    </COMMAND>

    <COMMAND
        name="no"
        help="Negate a command or set its defaults"
        >
    </COMMAND>

    <!-- router-id command -->
    <COMMAND
        name="router-id"
        help="Configure BGP router identifier"
        >
        <PARAM
            name="router-id-addr"
            help="Router ID in IPv4 address format"
            ptype="IP_ADDR"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp patch_openconfig_bgp_bgp_global_config ${as} ${router-id-addr}</ACTION>
    </COMMAND>

    <!-- no router-id command -->
    <COMMAND
        name="no router-id"
        help="Remove BGP router identifier"
        >
        <ACTION builtin="clish_pyobj">sonic-cli-bgp patch_openconfig_bgp_bgp_global_config ${as} 0.0.0.0</ACTION>
    </COMMAND>

    <!-- neighbor command -->
    <COMMAND name="neighbor" help="Configure BGP neighbor">
        <PARAM name="neighbor-ip" help="Neighbor IP address" ptype="IP_ADDR">
            <PARAM name="neighbor-subcommands" help="" ptype="SUBCOMMAND" mode="switch">
                <!-- remote-as subcommand -->
                <PARAM name="remote-as" help="Specify a BGP neighbor" ptype="SUBCOMMAND" mode="subcommand">
                    <PARAM name="as-number" help="AS number" ptype="RANGE_1_4294967295">
                    </PARAM>
                </PARAM>
                <!-- description subcommand -->
                <PARAM name="description" help="Neighbor specific description" ptype="SUBCOMMAND" mode="subcommand">
                    <PARAM name="desc-text" help="Description text" ptype="STRING">
                    </PARAM>
                </PARAM>
                <!-- update-source subcommand -->
                <PARAM name="update-source" help="Source of routing updates" ptype="SUBCOMMAND" mode="subcommand">
                    <PARAM name="source-ip" help="Source IP address" ptype="IP_ADDR">
                    </PARAM>
                </PARAM>
            </PARAM>
        </PARAM>
        <ACTION>
            if test "${neighbor-subcommands}" = "remote-as"; then&#xA;
                python3 $SONIC_CLI_ROOT/sonic-cli-bgp.py put_openconfig_bgp_bgp_neighbors_neighbor_remote_as ${neighbor-ip} ${as-number}&#xA;
            elif test "${neighbor-subcommands}" = "description"; then&#xA;
                python3 $SONIC_CLI_ROOT/sonic-cli-bgp.py put_openconfig_bgp_bgp_neighbors_neighbor_description ${neighbor-ip} ${desc-text}&#xA;
            elif test "${neighbor-subcommands}" = "update-source"; then&#xA;
                python3 $SONIC_CLI_ROOT/sonic-cli-bgp.py put_openconfig_bgp_bgp_neighbors_neighbor_update_source ${neighbor-ip} ${source-ip}&#xA;
            fi
        </ACTION>
    </COMMAND>

    <!-- no neighbor command -->
    <COMMAND
        name="no neighbor"
        help="Remove BGP neighbor configuration"
        >
        <PARAM
            name="neighbor-ip"
            help="Neighbor IP address"
            ptype="IP_ADDR"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp delete_openconfig_bgp_bgp_neighbors_neighbor ${neighbor-ip}</ACTION>
    </COMMAND>

</VIEW>

</CLISH_MODULE>
