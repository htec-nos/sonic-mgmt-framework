<?xml version="1.0" encoding="UTF-8"?>

<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xi="http://www.w3.org/2001/XInclude"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd"
    >

<!-- MODE: configure terminal -->
<VIEW name="configure-view">
    <!-- router bgp command -->
    <COMMAND name="router" help="Enable a routing process">
    </COMMAND>

    <COMMAND
        name="router bgp"
        help="Configure BGP routing protocol"
        view="configure-bgp-view"
        viewid="as=${bgp-as-number}"
        >
        <PARAM
            name="bgp-as-number"
            help="AS number"
            ptype="RANGE_1_4294967295"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp post_openconfig_bgp_bgp_global ${bgp-as-number} 0.0.0.0</ACTION>
    </COMMAND>

    <!-- no router bgp command -->
    <COMMAND name="no router" help="Disable a routing process">
    </COMMAND>

    <COMMAND
        name="no router bgp"
        help="Remove BGP routing protocol configuration"
        >
        <PARAM
            name="bgp-as-number"
            help="AS number"
            ptype="RANGE_1_4294967295"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp delete_openconfig_bgp_bgp_global</ACTION>
    </COMMAND>

    <!-- ip prefix-list command -->
    <COMMAND name="ip prefix-list" help="Configure IPv4 prefix-list">
        <PARAM 
            name="prefix-list-name"
            help="Name of the IPv4 prefix-list"
            ptype="STRING_63"
            >
            <PARAM
                name="seq"
                help="Sequence number"
                ptype="SUBCOMMAND"
                mode="subcommand"
                >
                <PARAM
                    name="seq-no"
                    help="Sequence number"
                    ptype="RANGE_1_65535"
                    >
                    <PARAM
                        name="action-switch"
                        help=""
                        ptype="SUBCOMMAND"
                        mode="switch"
                        >
                        <PARAM
                            name="permit"
                            help="Permit matching prefixes"
                            ptype="SUBCOMMAND"
                            mode="subcommand"
                            >
                            <PARAM
                                name="ip-prefix"
                                help="IP prefix (A.B.C.D/mask)"
                                ptype="IP_ADDR_MASK"
                                >
                                <PARAM
                                    name="le"
                                    help="Maximum prefix length to be matched"
                                    ptype="SUBCOMMAND"
                                    mode="subcommand"
                                    optional="true"
                                    >
                                    <PARAM  
                                        name="le-value"
                                        help="Maximum prefix length (0-32 for IPv4)"
                                        ptype="RANGE_0_32"
                                        >  
                                    </PARAM>
                                </PARAM>
                                <PARAM
                                    name="ge"
                                    help="Minimum prefix length to be matched"
                                    ptype="SUBCOMMAND"
                                    mode="subcommand"
                                    optional="true"
                                    >
                                    <PARAM
                                        name="ge-value"
                                        help="Minimum prefix length (0-32 for IPv4)"
                                        ptype="RANGE_0_32"
                                        >
                                    </PARAM>
                                </PARAM>
                            </PARAM>
                        </PARAM>
                        <PARAM  
                            name="deny"
                            help="Deny matching prefixes"
                            ptype="SUBCOMMAND"
                            mode="subcommand"
                            >
                            <PARAM
                                name="ip-prefix"
                                help="IP prefix (A.B.C.D/mask)"
                                ptype="IP_ADDR_MASK"
                                >
                                <PARAM
                                    name="le"
                                    help="Maximum prefix length to be matched"
                                    ptype="SUBCOMMAND"
                                    mode="subcommand"
                                    optional="true"
                                    >
                                    <PARAM
                                        name="le-value"
                                        help="Maximum prefix length (0-32 for IPv4)"
                                        ptype="RANGE_0_32"
                                        >
                                    </PARAM>
                                </PARAM>
                                <PARAM
                                    name="ge"
                                    help="Minimum prefix length to be matched"
                                    ptype="SUBCOMMAND"
                                    mode="subcommand"
                                    optional="true"
                                    >
                                    <PARAM
                                        name="ge-value"
                                        help="Minimum prefix length (0-32 for IPv4)"
                                        ptype="RANGE_0_32"
                                        >
                                    </PARAM>
                                </PARAM>
                            </PARAM>
                        </PARAM>
                    </PARAM>
                </PARAM>
            </PARAM>
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp put_openconfig_routing_policy_defined_sets_prefix_sets_prefix_set ${prefix-list-name} ${action-switch} ${ip-prefix} ${le-value} ${ge-value}</ACTION>
    </COMMAND>

    <!-- no ip prefix-list -->
    <COMMAND
        name="no ip prefix-list"
        help="Remove IPv4 prefix-list"
        >
        <PARAM
            name="prefix-list-name"
            help="Name of the IPv4 prefix-list"
            ptype="STRING_63"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp delete_openconfig_routing_policy_defined_sets_prefix_sets_prefix_set ${prefix-list-name}</ACTION>
    </COMMAND>
</VIEW>

<!-- MODE: router bgp view -->
<VIEW
    name="configure-bgp-view"
    prompt="${SYSTEM_NAME}(config-router-bgp)# "
    depth="2"
    >
    <!-- Inheritance from configure-view -->
    <NAMESPACE
        ref="configure-view"
        help="false"
        completion="false"
        />

    <!-- show configuration -->
    <COMMAND name="show" help="Show configuration">
    </COMMAND>
    <COMMAND
        name="show bgp-global-config"
        help="Show BGP Global configuration"
        >
        <ACTION builtin="clish_pyobj">sonic-cli-bgp show_openconfig_bgp_bgp_global_config bgp_global_show.j2</ACTION>
    </COMMAND>

    <COMMAND
        name="no"
        help="Negate a command or set its defaults"
        >
    </COMMAND>

    <!-- router-id command -->
    <COMMAND
        name="router-id"
        help="Configure BGP router identifier"
        >
        <PARAM
            name="router-id-addr"
            help="Router ID in IPv4 address format"
            ptype="IP_ADDR"
            >
        </PARAM>
        <ACTION builtin="clish_pyobj">sonic-cli-bgp patch_openconfig_bgp_bgp_global_config ${as} ${router-id-addr}</ACTION>
    </COMMAND>

    <!-- no router-id command -->
    <COMMAND
        name="no router-id"
        help="Remove BGP router identifier"
        >
        <ACTION builtin="clish_pyobj">sonic-cli-bgp patch_openconfig_bgp_bgp_global_config ${as} 0.0.0.0</ACTION>
    </COMMAND>
</VIEW>

</CLISH_MODULE>
